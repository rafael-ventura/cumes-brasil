# API e assets: use 8080 quando rodar backend direto (npm run dev); use 3001 com Docker
VITE_APP_API_URL=http://localhost:8080/api
VITE_APP_SERVER_IP=http://localhost:8080
VITE_GOOGLE_CLIENT_ID="change-me"
